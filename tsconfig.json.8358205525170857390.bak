{
  "compilerOptions": {
    "target": "es2022",
    "module": "esNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "sourceMap": true,
    "inlineSources": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "baseUrl": "./src/main/frontend",
    "paths": {
      "frontend/*": ["*"],
      "services/*": ["services/*"],
      "generated/*": ["generated/*"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./src/main/frontend/generated"
    ],
    "types": []
  },
  "include": [
    "src/main/frontend/**/*",
    "src/main/frontend/generated/**/*",
    "src/main/frontend/services/**/*",
    "src/main/frontend/types.d.ts"
  ],
  "exclude": [
    "src/main/frontend/generated/jar-resources/**"
  ]
}